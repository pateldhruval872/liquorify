{
  "what": "Admin API checks on the dashboard browser tests' Rails server, as its admin, on 2026-11-04. Each record made for a check was deleted after it.",
  "spree_code_at": "ffc9f5e",
  "server": "The dashboard browser tests' own Rails server and fixtures, with Spree's sample catalog and the records fidelity/loyalty.ts adds",
  "checks": [
    {
      "for": "G-14 (record §4)",
      "steps": [
        {
          "request": "POST /api/v3/admin/gift_cards",
          "body": {
            "amount": "5.00",
            "currency": "USD",
            "code": "FIDELITY-G14-CHECK"
          },
          "status": 201,
          "answer": {
            "status": "active"
          }
        },
        {
          "request": "PATCH /api/v3/admin/gift_cards/<id>",
          "body": {
            "status": "canceled"
          },
          "status": 200,
          "answer": {
            "status": "active"
          }
        },
        {
          "request": "GET /api/v3/admin/gift_cards/<id>",
          "status": 200,
          "answer": {
            "status": "active"
          }
        },
        {
          "request": "PATCH /api/v3/admin/gift_cards/<id>/cancel",
          "body": {},
          "status": 404,
          "answer": "No route matches"
        },
        {
          "request": "POST /api/v3/admin/gift_cards/<id>/cancel",
          "body": {},
          "status": 404
        },
        {
          "request": "DELETE /api/v3/admin/gift_cards/<id>",
          "status": 204
        },
        {
          "request": "GET /api/v3/admin/gift_cards/<id>",
          "status": 404,
          "answer": {
            "error": {
              "code": "record_not_found",
              "message": "Gift card not found"
            }
          }
        }
      ],
      "observed": "No request cancels a gift card: the status in a change is ignored and there is no cancel route."
    },
    {
