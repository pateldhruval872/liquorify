{
  "meta": {
    "currency": "USD",
    "timezone": "UTC",
    "supported_currencies": ["USD", "EUR"]
  },
  "families": [
    {
      "name": "sales",
      "label": "Sales",
      "metrics": [
        "gross_sales",
        "discounts",
        "returns",
        "net_sales",
        "shipping",
        "duties",
        "fees",
        "taxes",
        "total_sales",
        "orders",
        "units_sold",
        "customers",
