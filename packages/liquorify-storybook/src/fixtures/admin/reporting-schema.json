    },
    {
      "name": "inventory",
      "label": "Inventory",
      "metrics": ["units_received", "units_shipped", "units_adjusted", "sell_through"],
      "dimensions": ["moved_at", "movement_kind", "moved_variant", "stock_location"]
    },
    {
      "name": "carts",
      "label": "Carts",
      "metrics": [
        "carts_started",
        "carts_converted",
        "carts_abandoned",
        "abandoned_value",
        "cart_conversion_rate"
      ],
      "dimensions": ["started_at", "cart_status", "cart_channel"]
    }
  ],
  "metrics": [
    {
      "name": "gross_sales",
      "family": "sales",
      "label": "Gross sales",
      "description": "Item prices multiplied by quantity, before discounts, returns and tax.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "discounts",
      "family": "sales",
      "label": "Discounts",
      "description": "Discounts applied to the items sold.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "returns",
      "family": "sales",
      "label": "Returns",
      "description": "Money refunded, counted in the period the refund was issued.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "net_sales",
      "family": "sales",
      "label": "Net sales",
      "description": "Gross sales less discounts and returns. What you actually sold.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "shipping",
      "family": "sales",
      "label": "Shipping",
      "description": "Delivery charged to the customer.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "duties",
      "family": "sales",
      "label": "Duties",
      "description": "Customs duties charged on the order.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "fees",
      "family": "sales",
      "label": "Fees",
      "description": "Shopper-visible fees other than duties.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "taxes",
      "family": "sales",
      "label": "Taxes",
      "description": "Sum of additional and included taxes.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "total_sales",
      "family": "sales",
      "label": "Total sales",
      "description": "Net sales plus shipping, duties, fees and taxes. The money taken.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "orders",
      "family": "sales",
      "label": "Orders",
      "description": "Number of placed orders.",
      "format": "integer",
      "derived": false,
      "filterable": true
    },
    {
      "name": "units_sold",
      "family": "sales",
      "label": "Units sold",
      "description": "Sum of line item quantities.",
      "format": "integer",
      "derived": false,
      "filterable": true
    },
    {
      "name": "customers",
      "family": "sales",
      "label": "Customers",
      "description": "Distinct customer emails that placed orders.",
      "format": "integer",
      "derived": false,
      "filterable": true
    },
    {
      "name": "average_order_value",
      "family": "sales",
      "label": "Average order value",
      "description": "Total sales divided by the number of orders.",
      "format": "money",
      "currency": "USD",
      "derived": true,
      "filterable": false
    },
    {
      "name": "cost_of_goods",
      "family": "sales",
      "label": "Cost of goods",
      "description": "What the goods sold cost you. Variants with no cost price count as zero.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "gross_profit",
      "family": "sales",
      "label": "Gross profit",
      "description": "Net sales less the cost of the goods sold.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "gross_margin",
      "family": "sales",
      "label": "Gross margin",
      "description": "Gross profit as a share of net sales.",
      "format": "percent",
      "derived": true,
      "filterable": false
    },
    {
      "name": "commission",
      "family": "sales",
      "label": "Commission",
      "description": "What the marketplace earned on these sales, including its tax.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "seller_payout",
      "family": "sales",
      "label": "Seller payout",
      "description": "What the sellers are owed on these sales, after commission.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "payments_received",
      "family": "payments",
      "label": "Payments received",
      "description": "Money successfully taken, counted when the payment was made.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "payments_refunded",
      "family": "payments",
      "label": "Payments refunded",
      "description": "Money refunded through these payments.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "net_payments",
      "family": "payments",
      "label": "Net payments",
      "description": "Money taken less money refunded, by the instrument that moved it.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "payments_count",
      "family": "payments",
      "label": "Payments",
      "description": "Number of successful charges.",
      "format": "integer",
      "derived": false,
      "filterable": true
    },
    {
      "name": "payments_failed",
      "family": "payments",
      "label": "Failed payments",
      "description": "Number of charges that failed.",
      "format": "integer",
      "derived": false,
      "filterable": true
    },
    {
      "name": "units_received",
      "family": "inventory",
      "label": "Units received",
      "description": "Units booked into stock.",
      "format": "integer",
      "derived": false,
      "filterable": true
    },
    {
      "name": "units_shipped",
      "family": "inventory",
      "label": "Units shipped",
      "description": "Units dispatched from stock.",
      "format": "integer",
      "derived": false,
      "filterable": true
    },
    {
      "name": "units_adjusted",
      "family": "inventory",
      "label": "Units adjusted",
      "description": "Units added or removed by stock corrections.",
      "format": "integer",
      "derived": false,
      "filterable": true
    },
    {
      "name": "sell_through",
      "family": "inventory",
      "label": "Sell-through",
      "description": "Units shipped as a share of units received.",
      "format": "percent",
      "derived": true,
      "filterable": false
    },
    {
      "name": "carts_started",
      "family": "carts",
      "label": "Carts started",
      "description": "Carts created in the period.",
      "format": "integer",
      "derived": false,
      "filterable": true
    },
    {
      "name": "carts_converted",
      "family": "carts",
      "label": "Converted carts",
      "description": "Carts that became an order. A basket split across sellers counts once.",
      "format": "integer",
      "derived": false,
      "filterable": true
    },
    {
      "name": "carts_abandoned",
      "family": "carts",
      "label": "Abandoned carts",
      "description": "Carts that never completed and have been untouched for longer than the store abandoned-cart window.",
      "format": "integer",
      "derived": false,
      "filterable": true
    },
    {
      "name": "abandoned_value",
      "family": "carts",
      "label": "Abandoned cart value",
      "description": "What the abandoned carts were worth. Carts are deleted once they expire, so a range longer than the cart expiry window under-reports.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "cart_conversion_rate",
      "family": "carts",
      "label": "Cart conversion rate",
      "description": "Share of carts started in the period that became orders. This counts baskets, not visits — it is not a storefront conversion rate.",
      "format": "percent",
      "derived": true,
      "filterable": false
    },
    {
      "name": "promotion_discounts",
      "family": "sales",
      "label": "Promotion discounts",
      "description": "Money discounted by promotions, shown as a positive amount.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "promotion_redemptions",
      "family": "sales",
      "label": "Promotion redemptions",
      "description": "How many checkouts used a promotion. A basket split across sellers counts once.",
      "format": "integer",
      "derived": false,
      "filterable": true
    },
    {
      "name": "customer_lifetime_value",
      "family": "sales",
      "label": "Customer lifetime value",
      "description": "Everything a customer has ever spent, net of refunds. Ignores the report date range: the range selects which customers appear, not which of their orders count.",
      "format": "money",
      "currency": "USD",
      "derived": false,
      "filterable": true
    },
    {
      "name": "orders_lifetime",
      "family": "sales",
      "label": "Lifetime orders",
      "description": "How many orders a customer has ever placed. Ignores the report date range, like customer lifetime value.",
      "format": "integer",
      "derived": false,
      "filterable": true
    }
  ],
