        "gross_margin",
        "commission",
        "seller_payout",
        "promotion_discounts",
        "promotion_redemptions",
        "customer_lifetime_value",
        "orders_lifetime"
      ],
      "dimensions": [
        "completed_at",
        "payment_status",
        "fulfillment_status",
        "country",
        "market",
        "channel",
        "customer_type",
        "seller",
        "customer",
        "company",
        "category",
        "variant",
        "product",
        "promotion",
