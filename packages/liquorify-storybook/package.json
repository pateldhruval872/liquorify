{
  "name": "@liquorify/storybook",
  "private": true,
  "version": "0.0.0",
  "description": "Liquorify's Storybook of Spree's dashboard design system, framework, admin dashboard and seller panel components, with token files and Playwright visual checks. Not published.",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build --output-dir storybook-static",
    "inventory:ids": "node scripts/inventory-ids.mjs",
    "tokens": "node scripts/tokens.mjs tokens.config.json",
    "tokens:check": "node scripts/tokens.mjs tokens.config.json --check && node scripts/inventory-ids.mjs --check",
    "coverage": "node scripts/coverage.mjs",
    "visual": "sh visual/in-image.sh",
    "visual:update": "sh visual/in-image.sh --update-snapshots=changed",
    "visual:copy": "node scripts/copy-references.mjs",
    "lint": "biome check .storybook src scripts visual",
    "lint:fix": "biome check --fix .storybook src scripts visual",
    "format": "biome format --write .storybook src scripts visual",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@spree/admin-sdk": "workspace:*",
    "@spree/dashboard": "workspace:*",
    "@spree/dashboard-core": "workspace:*",
    "@spree/dashboard-ui": "workspace:*",
    "@spree/seller-dashboard": "workspace:*",
    "@spree/seller-sdk": "workspace:*",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "i18next": "^26.4.7",
    "msw": "^3.0.3",
    "msw-storybook-addon": "3.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.0.20",
    "storybook": "10.6.2",
    "tailwindcss": "^4.2.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
